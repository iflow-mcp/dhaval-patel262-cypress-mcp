{
  "name": "@cypress/mcp",
  "version": "0.0.1",
  "description": "Cypress Tools for MCP",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/araval/cypress-mcp.git"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "lint": "eslint . && tsc --noEmit",
